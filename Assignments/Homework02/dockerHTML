FROM python:3.12

RUN pip install flask

WORKDIR /code

COPY contact.html /code/index.html
COPY index.html /code/contacts.html
COPY tests.html /code/tests.html

RUN chmod +rx /code/index.html
RUN chmod +rx /code/contacts.html
RUN chmod +rx /code/tests.html

ENV PATH="/code:$PATH"

EXPOSE 8000

CMD ["python3", "-m", "http.server", "8000"]

