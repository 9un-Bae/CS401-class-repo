FROM ubuntu:20.04

RUN apt-get update && apt-get upgrade -y && apt-get install -y curl git vim

RUN DEBIAN_FRONTEND=noninteractive apt-get install -y software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get install -y python3.12 \
    && curl https://bootstrap.pypa.io/get-pip.py -o get-pip.py && python3.12 get-pip.py

RUN pip install flask

WORKDIR /code

COPY contact.html /code/
COPY index.html /code/
COPY tests.html /code/

COPY computer.py /code/
COPY writer.py /code/

EXPOSE 8000

CMD ["python3.12", "-m", "http.server", "8000"]

